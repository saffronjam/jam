[jam-fixture-base]
name=Archived Fedora 42 base for KWin 6.6 software Wayland tests
baseurl=https://archives.fedoraproject.org/pub/archive/fedora/linux/releases/42/Everything/$basearch/os/
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-42-$basearch

[jam-fixture-updates]
name=Archived Fedora 42 updates for KWin 6.6 software Wayland tests
baseurl=https://archives.fedoraproject.org/pub/archive/fedora/linux/updates/42/Everything/$basearch/
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-42-$basearch
