diff --git a/inputsynth/interaction.cpp b/inputsynth/interaction.cpp
--- a/inputsynth/interaction.cpp
+++ b/inputsynth/interaction.cpp
@@ -19,0 +20 @@
+#include <QElapsedTimer>
@@ -391,0 +393,27 @@
+    // Send a timed gesture instead of one smooth frame followed by a sleep.
+    // GTK establishes its scroll sequence on the first frame.
+    constexpr unsigned long frameDuration = 25;
+    const auto steps = qMax(1UL, (m_duration + frameDuration - 1) / frameDuration);
+    QElapsedTimer timer;
+    timer.start();
+    QPoint sent;
+    for (unsigned long step = 1; step <= steps; ++step) {
+        const QPoint total(qRound(double(m_deltaPos.x()) * step / steps),
+                           qRound(double(m_deltaPos.y()) * step / steps));
+        const QPoint delta = total - sent;
+        if (delta.x() != 0) {
+            s_interface->axis(WL_POINTER_AXIS_HORIZONTAL_SCROLL, wl_fixed_from_int(delta.x()));
+            s_interface->roundtrip();
+        }
+        if (delta.y() != 0) {
+            s_interface->axis(WL_POINTER_AXIS_VERTICAL_SCROLL, wl_fixed_from_int(delta.y()));
+            s_interface->roundtrip();
+        }
+        sent = total;
+        const qint64 targetTime = static_cast<qint64>(m_duration * step / steps);
+        const qint64 remaining = targetTime - timer.elapsed();
+        if (remaining > 0) {
+            QThread::msleep(static_cast<unsigned long>(remaining));
+        }
+    }
+    // Zero axis values terminate the Wayland smooth-scroll sequence.
@@ -393 +421 @@
-        s_interface->axis(WL_POINTER_AXIS_HORIZONTAL_SCROLL, wl_fixed_from_int(m_deltaPos.x()));
+        s_interface->axis(WL_POINTER_AXIS_HORIZONTAL_SCROLL, 0);
@@ -397 +425 @@
-        s_interface->axis(WL_POINTER_AXIS_VERTICAL_SCROLL, wl_fixed_from_int(m_deltaPos.y()));
+        s_interface->axis(WL_POINTER_AXIS_VERTICAL_SCROLL, 0);
